# Safe local defaults. Copy to .env and replace only the values you explicitly use.
DEEPSEEK_MODEL=deepseek-v4-flash
LOTTERY_LUCK_AI_ENABLED=true

# Production required for /api/admin/*.
# Leave blank locally to keep the admin API locked. Never deploy CHANGE_ME as a real token.
LOTTERY_LUCK_ADMIN_TOKEN=
# LOTTERY_LUCK_ADMIN_TOKEN=CHANGE_ME_GENERATED_SECRET_PRODUCTION_REQUIRED

# Automatic data updates are off by default. 21600 seconds is the recommended 6-hour period.
LOTTERY_LUCK_AUTO_UPDATE_ENABLED=false
LOTTERY_LUCK_AUTO_UPDATE_INTERVAL_SECONDS=21600

# Optional Turso/libSQL production database. Leave blank locally to use DB_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional runtime overrides recognized by the codebase.
# LOTTERY_LUCK_SETTINGS_PATH=/absolute/path/settings.json
# SPORTS_LOTTERY_API_BASE_URL=https://webapi.sporttery.cn
